# =============================================================================
# Supabase — copier en .env (jamais commité) et remplir avec les vraies valeurs
# =============================================================================

# --- Côté serveur (server functions / Cloudflare Worker) ---
# Lus via process.env dans src/lib/supabase/server.ts
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SECRET — ne JAMAIS exposer côté navigateur, ne JAMAIS commiter.
# En production Cloudflare, l'injecter via `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Côté navigateur (bundle Vite — préfixe VITE_ obligatoire) ---
# Mêmes valeurs URL / clé anon que ci-dessus. Vite n'expose au client que les
# variables préfixées VITE_ via import.meta.env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
